# Beispiel .env-Datei für die Entwicklung
# Diese Datei als ".env" kopieren und Werte anpassen.
# Die Datei ".env" darf nicht ins Git-Repository eingecheckt werden.

# =========================
# Datenbankkonfiguration
# =========================
DB_HOST=db
DB_PORT=3306
DB_NAME=HIERNAMEFÜRDIEDB
DB_USER=HIERNAMEFÜRDBUSER
DB_PASSWORD=HIERPASSWORDFÜRDB
DB_ROOT_PASSWORD=HIERPASSWORDFÜRDBROOT

# =========================
# ASP.NET Core Umgebung
# =========================
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# =========================
# CORS-Konfiguration
# =========================
# Kommagetrennte Liste erlaubter Origins (ohne Leerzeichen).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.178.115:5173

# =========================
# Frontend-Konfiguration
# =========================
# Muss mit einer erlaubten CORS-Origin übereinstimmen.
VITE_API_BASE_URL=http://111.111.111:5000

# =========================
# Initialer Admin-Seed
# =========================
# Legt User und Initiative in der DB an sofern noch keiner vorhanden ist.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_INITIATIVE_NAME=Default

# =========================
# Datenbank Retry
# =========================
# Anzahl Versuche, bis die Datenbank erreichbar sein muss.
DB_SEED_MAX_ATTEMPTS=10

# =========================
# JWT Konfiguration
# =========================
JWT_SECRET=super_langer_geheimer_schluessel_123456789
JWT_ISSUER=BuergerbusAPI
JWT_AUDIENCE=BuergerbusFrontend
JWT_EXPIRES_MINUTES=60