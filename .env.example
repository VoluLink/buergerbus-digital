# ==========================================================
# Beispiel .env Datei für Docker Compose
# Diese Datei als ".env" kopieren und die Werte anpassen.
#
# Wenn was Aktiviert werden soll # entfernen und wert ausfüllen.
# ==========================================================

# =========================
# Datenbank (MariaDB)
# =========================
DB_HOST=db
DB_PORT=3306
DB_NAME=buergerbus
DB_USER=fahrplan
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# =========================
# Backend / Startmodus
# =========================
# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production

# development | staging | production
APP_RUN_MODE=production

# dev | staging | prod | ci
COMPOSE_PROFILES=prod

# =========================
# Setup / Nutzungsmodus
# =========================
# LOCALHOST  = Zugriff über localhost
# SERVER_IP  = Zugriff über eine Server-IP im Netzwerk
# DOMAIN     = Zugriff über eine Domain/Subdomain
USAGE_MODE=DOMAIN

# Öffentliche Adresse des Frontends
# Development lokal:
# FRONTEND_ORIGIN=http://localhost:5173
#
# Development über Server-IP:
# FRONTEND_ORIGIN=http://<SERVER-IP>:5173
#
# Production über Domain:
FRONTEND_ORIGIN=https://<DOMAIN>

# =========================
# Frontend- und CORS-Konfiguration
# =========================
# Welche Ports werden wann verwendet?
#
# Development:
# - 5173 = Frontend über Vite Dev Server
# - 5000 = Backend/API über Docker-Portfreigabe
#
# Production:
# - Der Browser ruft normalerweise nur die Domain auf:
#   https://<DOMAIN>
# - Es wird kein Port angegeben, weil HTTPS automatisch Port 443 nutzt.
# - Port 80 wird im Produktivbetrieb nur intern verwendet:
#   Nginx Proxy Manager → Frontend-Container
#
# Wichtig:
# - FRONTEND_ORIGIN und FRONTEND_URL zeigen immer auf das Frontend.
# - VITE_API_BASE_URL muss aus dem Browser erreichbar sein.
# - In Production darf VITE_API_BASE_URL kein "/api" enthalten.
# - Port 8080 ist nur der interne Backend-Port im Docker-Netzwerk
#   und wird normalerweise nicht direkt im Browser verwendet.

# Development lokal:
# FRONTEND_ORIGIN=http://localhost:5173
# FRONTEND_URL=http://localhost:5173
# VITE_API_BASE_URL=http://localhost:5000
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development über Server-IP:
# FRONTEND_ORIGIN=http://<SERVER-IP>:5173
# FRONTEND_URL=http://<SERVER-IP>:5173
# VITE_API_BASE_URL=http://<SERVER-IP>:5000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<SERVER-IP>:5173

# Production über Domain:
# FRONTEND_ORIGIN=https://<DOMAIN>
# FRONTEND_URL=https://<DOMAIN>
# VITE_API_BASE_URL=https://<DOMAIN>
# CORS_ALLOWED_ORIGINS=https://<DOMAIN>

# =========================
# Passwort-Zurücksetzen
# =========================
# Link, der in Passwort-Zurücksetzen-Mails verwendet wird.
#
# Development lokal:
# FRONTEND_URL=http://localhost:5173
#
# Development über Server-IP:
# FRONTEND_URL=http://<SERVER-IP>:5173
#
# Production:
FRONTEND_URL=https://<DOMAIN>

# =========================
# JWT Konfiguration
# =========================
# Für Production unbedingt einen langen zufälligen Secret verwenden.
# Beispiel zum Erzeugen:
# openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_LONG_RANDOM_SECRET
JWT_ISSUER=BuergerbusAPI
JWT_AUDIENCE=BuergerbusFrontend
JWT_EXPIRES_MINUTES=20

# =========================
# E-Mail / SMTP
# =========================
# Development mit Mailpit:
# EMAIL_SMTP_HOST=mailpit
# EMAIL_SMTP_PORT=1025
# EMAIL_SMTP_USERNAME=
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=noreply@buergerbus.local
# EMAIL_FROM_NAME=Bürgerbus
# EMAIL_USE_SSL=false
#
# Production mit echtem SMTP-Server:
EMAIL_SMTP_HOST=mail.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=noreply@example.com
EMAIL_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_FROM_NAME=Bürgerbus
EMAIL_USE_SSL=false

# Hinweis:
# EMAIL_FROM_ADDRESS muss eine gültige E-Mail-Adresse sein.
#
# Richtig:
# EMAIL_FROM_ADDRESS=noreply@example.com
#
# Falsch:
# EMAIL_FROM_ADDRESS=Bürgerbus
#
# Bei Port 587 wird meistens STARTTLS verwendet.
# Dann ist EMAIL_USE_SSL=false normalerweise korrekt.
#
# Bei Port 465 wird meistens direktes SSL/TLS verwendet.
# Dann ist EMAIL_USE_SSL=true normalerweise korrekt.

# =========================
# Initialer Admin-Seed (Backend)
# =========================
# Legt einen initialen Admin-Benutzer und eine Initiative an,
# sofern noch kein Benutzer vorhanden ist.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_INITIATIVE_NAME=Default

# =========================
# Seed / Migration Retry
# =========================
# Anzahl der Versuche, bis die Datenbank erreichbar sein muss.
DB_SEED_MAX_ATTEMPTS=10