DB_HOST=db
DB_PORT=3306
DB_NAME=HIERNAMEFÜRDIEDB
DB_USER=HIERNAMEFÜRDBUSER
DB_PASSWORD=HIERPASSWORDFÜRDB
DB_ROOT_PASSWORD=HIERPASSWORDFÜRDBROOT

ASPNETCORE_ENVIRONMENT=Development

# CORS (Backend): Kommagetrennte Liste erlaubter Origins für Browser-Requests
# Beispiel: lokale Entwicklung + Zugriff über LAN-IP
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.178.115:5173

VITE_API_BASE_URL=http://localhost:5000

# Optional: initialer Admin-User Seed (Backend)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_INITIATIVE_NAME=Default

# Optional: Seed/Migration Retry (Backend)
# Anzahl Versuche, bis DB erreichbar sein muss (Default: 10)
DB_SEED_MAX_ATTEMPTS=10