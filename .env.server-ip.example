# ==========================================================
# Entwicklung über eine Server-IP (nicht für Production)
# Kopiere diese Datei nach .env, ersetze <SERVER-IP> und alle CHANGE_ME-Werte.
# ==========================================================

COMPOSE_PROFILES=dev
ASPNETCORE_ENVIRONMENT=Development

# Metadaten für den Setup-Assistenten (start.sh)
USAGE_MODE=SERVER_IP
FRONTEND_ORIGIN=http://<SERVER-IP>:5173

# Browser- und Backend-Konfiguration
VITE_API_BASE_URL=http://<SERVER-IP>:5000
FRONTEND_URL=http://<SERVER-IP>:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://<SERVER-IP>:5173

# MariaDB
DB_NAME=buergerbus
DB_USER=fahrplan
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ISSUER=BuergerbusAPI
JWT_AUDIENCE=BuergerbusFrontend
JWT_EXPIRES_MINUTES=20

# E-Mail: Mailpit wird im Development-Profil automatisch gestartet.
EMAIL_SMTP_HOST=mailpit
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@buergerbus.local
EMAIL_FROM_NAME=Bürgerbus
EMAIL_USE_SSL=false

# Erster Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_INITIATIVE_NAME=Default

DB_SEED_MAX_ATTEMPTS=10
