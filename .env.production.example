# ==========================================================
# Produktivbetrieb mit Domain und Nginx Proxy Manager
# Kopiere diese Datei nach .env und ersetze <DOMAIN> sowie alle CHANGE_ME-Werte.
# ==========================================================

COMPOSE_PROFILES=prod
ASPNETCORE_ENVIRONMENT=Production

# Metadaten für den Setup-Assistenten (start.sh)
USAGE_MODE=DOMAIN
FRONTEND_ORIGIN=https://<DOMAIN>

# Öffentliche Browser- und Backend-Konfiguration
# Wichtig: VITE_API_BASE_URL ohne /api am Ende eintragen.
VITE_API_BASE_URL=https://<DOMAIN>
FRONTEND_URL=https://<DOMAIN>
CORS_ALLOWED_ORIGINS=https://<DOMAIN>

# MariaDB
DB_NAME=buergerbus
DB_USER=fahrplan
DB_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_ISSUER=BuergerbusAPI
JWT_AUDIENCE=BuergerbusFrontend
JWT_EXPIRES_MINUTES=20

# Produktiv-SMTP
# Port 587: EMAIL_USE_SSL=false (STARTTLS)
# Port 465: EMAIL_USE_SSL=true
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=noreply@example.com
EMAIL_SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM_ADDRESS=noreply@<DOMAIN>
EMAIL_FROM_NAME=Bürgerbus
EMAIL_USE_SSL=false

# Erster Administrator
SEED_ADMIN_EMAIL=admin@<DOMAIN>
SEED_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SEED_INITIATIVE_NAME=CHANGE_ME_INITIATIVE_NAME

DB_SEED_MAX_ATTEMPTS=10
